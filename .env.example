# ---------------------------------------------------------------------------
# Get Fed — environment configuration (PRD §61)
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker:  docker run -d --name fws-postgres \
#   -e POSTGRES_USER=fws -e POSTGRES_PASSWORD=fws_dev_password \
#   -e POSTGRES_DB=getfed -p 5432:5432 postgres:16-alpine
# Production:    Neon (postgresql://...neon.tech/...) or Supabase connection string.
DATABASE_URL="postgresql://fws:fws_dev_password@localhost:5432/getfed?schema=public"

# Auth.js session signing secret — generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Protects the cron expiry endpoint (/api/cron/expiry).
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="replace-with-a-random-cron-secret"

# ------------------------------ Optional -----------------------------------

# Firebase Cloud Messaging push notifications (PRD §25).
# The platform works fully without these — in-app notifications are the
# reliable MVP path; FCM activates only when BOTH values are configured.
# FCM_PROJECT_ID="your-firebase-project-id"
# FCM_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}'
