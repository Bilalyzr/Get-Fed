{
  "name": "get-fed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7777",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify:demo": "node scripts/verify-demo.mjs",
    "postinstall": "prisma generate",
    "start:7777": "next start -p 7777",
    "start:3777": "next start -p 3777",
    "db:up": "docker start fws-postgres || docker run -d --name fws-postgres -e POSTGRES_USER=fws -e POSTGRES_PASSWORD=fws_dev_password -e POSTGRES_DB=foodworthsaving -p 5544:5432 postgres:16-alpine",
    "stop": "node scripts/stop.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^6.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.12",
    "@types/three": "^0.186.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "next": "14.2.33",
    "next-auth": "^4.24.11",
    "prisma": "^6.5.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.4",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7",
    "three": "^0.186.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.2",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}